+def sample_jpeg(color=(190, 180, 170), size=(1200, 900)) -> bytes:
+    image = Image.new("RGB", size, color)
+    out = io.BytesIO()
+    image.save(out, format="JPEG", quality=90)
+    return out.getvalue()
