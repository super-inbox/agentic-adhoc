{
  "schema": "candidate-design-document/1.0",
  "version": "v1",
  "title": "MORI 陶土红香薰机纵向产品信息页",
  "canvas": {
    "width": 1200,
    "height": 1800,
    "unit": "px",
    "color_space": "sRGB"
  },
  "reference_contract": {
    "reference-page": {
      "allowed": ["layout_principles", "information_rhythm"],
      "identity_policy": "abstract_only",
      "not_reused": ["花瓶", "参考品牌名", "参考图标", "材料细节照片", "边框与表格装饰"]
    },
    "product": {
      "allowed": ["placement", "scale", "lighting_context"],
      "identity_policy": "preserve_exact",
      "implementation": "直接从原图提取像素并建立透明蒙版；不重绘、不调色、不改变轮廓"
    },
    "brand-board": {
      "allowed": ["palette", "typography", "brand_tokens"],
      "identity_policy": "preserve_rules"
    }
  },
  "tokens": {
    "colors": {
      "charcoal": "#30302D",
      "warm_ivory": "#F3EFE4",
      "paper": "#FBF8F0",
      "terracotta": "#B8543E",
      "terracotta_dark": "#8F3F32",
      "olive": "#8C9A69",
      "pale_blue": "#AECDD5",
      "hairline": "#D8D0BF"
    },
    "typography": {
      "display": {
        "family": "Songti SC",
        "fallback": "STSong",
        "weight": 700
      },
      "sans": {
        "family": "PingFang SC",
        "fallback": "Hiragino Sans GB, Arial Unicode MS",
        "weight": 400
      },
      "latin": {
        "family": "Arial",
        "fallback": "sans-serif",
        "weight": 600
      }
    },
    "spacing": {
      "outer_margin": 84,
      "section_gap": 70,
      "card_gap": 24,
      "card_radius": 26
    }
  },
  "assets": [
    {
      "id": "asset/product-source",
      "path": "../../inputs/02-product_reference.png",
      "role": "product_identity_source",
      "identity_policy": "preserve_exact"
    },
    {
      "id": "asset/product-cutout",
      "path": "assets/product_cutout.png",
      "role": "direct_pixel_cutout",
      "derived_from": "asset/product-source",
      "identity_operations": ["white-background alpha extraction", "tight crop"],
      "forbidden_operations": ["redraw", "recolor", "shape edit"]
    },
    {
      "id": "asset/clay-texture",
      "path": "assets/mori_fine_grain_clay_paper.png",
      "role": "generated_fine_grain_clay_paper_only",
      "generation_mode": "built-in image_gen",
      "contains": "uniform warm-ivory fine-grain clay paper with micro mineral particles and paper fibers",
      "excludes": ["watercolor wash", "cloudy mottling", "broad color blooms", "large gradients", "plaster wall", "text", "logo", "icon", "product", "vase", "leaf", "decorative motif"]
    }
  ],
  "groups": [
    {
      "id": "group/background",
      "label": "背景与细颗粒陶土纸感",
      "editable": true,
      "children": ["background/base", "background/grain", "hero/texture", "hero/veil", "hero/halo"]
    },
    {
      "id": "group/brand",
      "label": "MORI 品牌签名",
      "editable": true,
      "children": ["brand/mori", "brand/tagline", "brand/accent"]
    },
    {
      "id": "group/product",
      "label": "原产品主视觉",
      "editable": true,
      "identity_locked": true,
      "children": ["product/cutout"]
    },
    {
      "id": "group/title",
      "label": "主标题与一句话卖点",
      "editable": true,
      "children": ["title/line-1", "title/line-2", "subtitle/accent", "subtitle/copy"]
    },
    {
      "id": "group/features",
      "label": "三个功能",
      "editable": true,
      "children": ["feature/card-1", "feature/card-1-accent", "feature/card-1-number", "feature/card-1-copy", "feature/card-2", "feature/card-2-accent", "feature/card-2-number", "feature/card-2-copy", "feature/card-3", "feature/card-3-accent", "feature/card-3-number", "feature/card-3-copy"]
    },
    {
      "id": "group/specs",
      "label": "底部规格",
      "editable": true,
      "children": ["spec/background", "spec/top-accent", "spec/label", "spec/value-usbc", "spec/value-6h", "spec/value-280ml", "spec/divider-1", "spec/divider-2"]
    }
  ],
  "objects": [
    {
      "id": "background/base",
      "type": "rounded_rect",
      "x": 0,
      "y": 0,
      "width": 1200,
      "height": 1800,
      "radius": 0,
      "fill": "#F3EFE4",
      "editable": true
